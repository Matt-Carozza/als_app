{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["vite/client"],
    "composite": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/services": ["../packages/services/src/index"],
      "@shared/api": ["../packages/api/src/index"],
    }
  },
  "include": ["src"],
  "references": [
    { "path" : "../packages/services" },
    { "path" : "../packages/api" }
  ]
}