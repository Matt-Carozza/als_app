{
  "extends": ["../tsconfig.base.json", "../tsconfig.expo.json"],
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "paths": {
      "@/*": ["./*"],
      "@shared/api": ["../packages/api/src/index"],
      "@shared/events": ["../packages/events/src/index"],
      "@shared/domain": ["../packages/domain/src/index"],
      "@shared/services": ["../packages/services/src/index"],
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "references": [
    { "path" : "../packages/api" },
    { "path" : "../packages/events" },
    { "path" : "../packages/domain" },
    { "path" : "../packages/services" }
  ]
}